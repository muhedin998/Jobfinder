pipeline {
    agent any

    parameters {
        string(name: 'PORT', defaultValue: '8081', description: 'Port to run the app on')
    }

    environment {
        DEPLOY_PATH = "/opt/jobfinder"
        JAR_NAME = "jobfinder.jar"
    }

    stages {
        stage('Copy Artifact from Build Job') {
            steps {
                copyArtifacts(
                    projectName: 'Jobfinder Spring Boot',
                    selector: specific('lastSuccessfulBuild'),
                    filter: 'target/*.jar',
                    fingerprint: true,
                    target: 'target/'
                )
            }
        }

        stage('Deploy Application') {
            steps {
                script {
                    sh """
                        mkdir -p ${env.DEPLOY_PATH}
                        cp target/*.jar ${env.DEPLOY_PATH}/${env.JAR_NAME}
                        pkill -f ${env.JAR_NAME} || true
                        nohup java -jar ${env.DEPLOY_PATH}/${env.JAR_NAME} --server.port=${params.PORT} > ${env.DEPLOY_PATH}/app.log 2>&1 &
                    """
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                script {
                    sleep(time: 5, unit: 'SECONDS') // Give the app time to start
                    sh "curl -s http://localhost:${params.PORT}/actuator/health || true"
                }
            }
        }
    }
}