pipeline {
    agent any

    parameters {
        string(name: 'PORT', defaultValue: '8081', description: 'Port to run the app on')
    }

    environment {
        DEPLOY_PATH = "/opt/jobfinder"
        JAR_NAME = "jobfinder.jar"
        SERVICE_NAME = "jobfinder"
    }

    stages {
        // Copy the JAR from the build job
        stage('Copy Artifact') {
            steps {
                copyArtifacts(
                    projectName: 'Jobfinder Spring Boot',
                    selector: specific('lastSuccessfulBuild'),
                    filter: 'target/*.jar',
                    fingerprintArtifacts: true,  // Correct parameter name
                    target: 'target/'  // Optional: specify target directory
                )

                // Debugging: List the contents of the workspace
                sh 'ls -lR'
            }
        }

        // Stop old instance, deploy new JAR, and start via systemd
        stage('Deploy Application') {
            steps {
                script {
                    sh """

                        # Copy the new JAR
                        cp target/target/*.jar ${env.DEPLOY_PATH}/${env.JAR_NAME}

                        # Create systemd service file
                        cat <<EOF | sudo tee /etc/systemd/system/${env.SERVICE_NAME}.service
                        [Unit]
                        Description=JobFinder Application
                        After=network.target

                        [Service]
                        User=jenkins
                        WorkingDirectory=${env.DEPLOY_PATH}
                        ExecStart=/usr/bin/java -jar ${env.JAR_NAME} --server.port=${params.PORT}
                        SuccessExitStatus=143
                        Restart=always
                        RestartSec=3

                        [Install]
                        WantedBy=multi-user.target
                        EOF

                        # Reload and enable the service
                        systemctl daemon-reload
                        systemctl enable ${env.SERVICE_NAME}.service
                        systemctl restart ${env.SERVICE_NAME}.service
                    """
                }
            }
        }

        // Verify the app is running
        stage('Verify Deployment') {
            steps {
                script {
                    sleep(time: 5, unit: 'SECONDS') // Wait for app to start
                    def healthCheck = sh(
                        script: "curl -s http://localhost:${params.PORT}/actuator/health || echo 'FAILED'",
                        returnStdout: true
                    ).trim()

                    if (healthCheck.contains('"status":"UP"')) {
                        echo "✅ Application is running and healthy!"
                    } else {
                        error("❌ Deployment failed! Health check: ${healthCheck}")
                    }
                }
            }
        }
    }

    post {
        failure {
            slackSend(
                channel: '#deployments',
                message: "🚨 Deployment of JobFinder failed! Check Jenkins: ${env.BUILD_URL}"
            )
        }
        success {
            slackSend(
                channel: '#deployments',
                message: "✅ JobFinder deployed successfully on port ${params.PORT}! ${env.BUILD_URL}"
            )
        }
    }
}